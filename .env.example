# Copy to .env and fill in. Never commit .env.
# Every LLM setting can also be changed at runtime from the settings UI
# (GET/PUT /admin/llm); saved UI changes override the values here.
# Leave a line commented to use the built-in default shown.

# ─── Provider routing ────────────────────────────────────────────────
# LLM_ACTIVE_PROVIDER=anthropic          # anthropic | openai
# LLM_FALLBACK_PROVIDER=openai           # openai | anthropic | none (used if the active one fails)
# LLM_MAX_TOOL_ITERATIONS=8              # model calls per patient message, 1-16
# LLM_HISTORY_LIMIT=80                   # stored items replayed per turn

# ─── Anthropic (Messages API) ────────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5        # claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5 | claude-fable-5-1 | claude-opus-5
# ANTHROPIC_MAX_TOKENS=16000             # 256-128000 (above 16000 needs streaming)
# ANTHROPIC_STREAM=true
# ANTHROPIC_EFFORT=                      # low | medium | high | xhigh | max (blank = model default)
# ANTHROPIC_THINKING=adaptive            # adaptive | between_tools (Sonnet 5.5) | disabled (Haiku 5.5, Opus 5)
# ANTHROPIC_THINKING_DISPLAY=omitted     # omitted | summarized | updates (beta)
# ANTHROPIC_TOOL_CHOICE=auto             # auto | any (older models only) | none
# ANTHROPIC_DISABLE_PARALLEL_TOOL_USE=false
# ANTHROPIC_STRICT_TOOLS=true
# ANTHROPIC_EAGER_INPUT_STREAMING=true
# ANTHROPIC_STOP_SEQUENCES=[]            # JSON array of strings
# ANTHROPIC_PROMPT_CACHE=5m              # off | 5m | 1h
# ANTHROPIC_SERVICE_TIER=auto            # auto | standard_only
# ANTHROPIC_SPEED=standard               # standard | fast (beta, Opus 5.5 / Opus 5, premium price)
# ANTHROPIC_INFERENCE_GEO=               # e.g. us | global
# ANTHROPIC_REFUSAL_FALLBACK=true        # server-side fallback when a safety check declines
# ANTHROPIC_TASK_BUDGET_TOKENS=          # >= 20000, advisory budget for a tool loop (beta)
# ANTHROPIC_COMPACTION=false             # server-side compaction for very long chats (beta)
# ANTHROPIC_SEND_USER_ID=true            # opaque per-conversation id as metadata.user_id
# ANTHROPIC_TIMEOUT_MS=60000
# ANTHROPIC_MAX_RETRIES=2

# ─── OpenAI (Responses API) ──────────────────────────────────────────
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol               # gpt-6-astra | gpt-6.1-sol | gpt-6.1-terra | gpt-6-luna
# OPENAI_MAX_OUTPUT_TOKENS=16000         # includes reasoning tokens
# OPENAI_STREAM=true
# OPENAI_REASONING_EFFORT=               # none | minimal | low | medium | high | xhigh | max (per model)
# OPENAI_REASONING_SUMMARY=off           # off | auto | concise | detailed
# OPENAI_REASONING_CONTEXT=auto          # auto | current_turn | all_turns
# OPENAI_REASONING_MODE=standard         # standard | pro
# OPENAI_VERBOSITY=low                   # low | medium | high
# OPENAI_TOOL_CHOICE=auto                # auto | required | none
# OPENAI_PARALLEL_TOOL_CALLS=true
# OPENAI_STRICT_TOOLS=true
# OPENAI_STORE=false                     # false = OpenAI keeps nothing; history replayed by us
# OPENAI_TRUNCATION=auto                 # auto | disabled
# OPENAI_SERVICE_TIER=auto               # auto | default | flex | scale | priority | fast
# OPENAI_PROMPT_CACHE_KEY=per_location   # per_location | off
# OPENAI_PROMPT_CACHE_MODE=implicit      # implicit | explicit
# OPENAI_PROMPT_CACHE_PREWARM=false
# OPENAI_SEND_SAFETY_IDENTIFIER=true
# OPENAI_MODERATION=off                  # off | score | block
# OPENAI_TEMPERATURE=                    # 0-2, only with reasoning effort none (Terra, Luna)
# OPENAI_TOP_P=                          # 0-1, same rule
# OPENAI_INCLUDE_OBFUSCATION=false
# OPENAI_TIMEOUT_MS=60000
# OPENAI_MAX_RETRIES=2

# ─── API (NestJS) ────────────────────────────────────────────────────
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Required to read or change settings from the UI (sent as the x-admin-token header).
ADMIN_TOKEN=change-me
# DB_PATH=data/smile-desk.db

# ─── Web (Next.js) ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
